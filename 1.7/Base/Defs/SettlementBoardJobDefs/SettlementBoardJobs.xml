  <Settlement_Services.Framework.Defs.SettlementBoardJobDef>
    <defName>SettlementBoardJob_Logging</defName>
    <label>logging work</label>
    <description>Felling and clearing timber for a settlement that is short of hands.</description>
    <selectionWeight>1</selectionWeight>
    <durationDays>2~4</durationDays>
    <difficultyBias>-0.05</difficultyBias>
    <rewardMultiplier>0.95</rewardMultiplier>
    <flavorRulePack>SettlementBoardJob_Logging_Flavor</flavorRulePack>
    <patterns>
      <li>
        <kind>Crew</kind>
        <weight>3</weight>
        <skills>
          <li>
            <skill>Plants</skill>
          </li>
        </skills>
      </li>
      <li>
        <kind>Specialist</kind>
        <weight>1</weight>
        <maxPartySize>1</maxPartySize>
        <skills>
          <li>
            <skill>Plants</skill>
          </li>
        </skills>
      </li>
