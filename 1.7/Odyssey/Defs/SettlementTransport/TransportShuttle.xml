<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <WorldObjectDef ParentName="ShuttleWorldObjectBase">
    <defName>SettlementTransport_ShuttleFlight</defName>
    <label>chartered passenger shuttle</label>
    <worldObjectClass>Settlement_Services.Services.Transport.SettlementTransportFlight</worldObjectClass>
    <texture>World/WorldObjects/Expanding/PassengerShuttle</texture>
    <expandingIconTexture>World/WorldObjects/Expanding/PassengerShuttle</expandingIconTexture>
    <expandingIconDrawSize>1</expandingIconDrawSize>
    <canHaveMap>false</canHaveMap>
    <validLaunchTarget>false</validLaunchTarget>
  </WorldObjectDef>
  <ThingDef ParentName="ShuttleSkyfallerBase">
    <defName>SettlementTransport_IncomingShuttle</defName>
    <label>chartered passenger shuttle (incoming)</label>
    <thingClass>Settlement_Services.Services.Transport.SettlementTransportIncomingShuttle</thingClass>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/PassengerShuttle/PassengerShuttle</texPath>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,5)</drawSize>
    </graphicData>
    <size>(3,5)</size>
    <skyfaller>
      <anticipationSound>Shuttle_Landing</anticipationSound>
      <anticipationSoundTicks>250</anticipationSoundTicks>
      <ticksToImpactRange>200~250</ticksToImpactRange>
      <shadowSize>(3.5,5.5)</shadowSize>
      <rotationCurve>
        <points>
          <li>(0,30)</li>
          <li>(0.5,5)</li>
          <li>(0.9,-5)</li>
          <li>(0.95,0)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0.95,2.5)</li>
          <li>(1,0)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0.6,0.6)</li>
          <li>(0.95,0.1)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>
  <TransportShipDef>
    <defName>SettlementTransport_CharteredShuttle</defName>
    <label>chartered passenger shuttle</label>
    <shipThing>PassengerShuttle</shipThing>
    <arrivingSkyfaller>SettlementTransport_IncomingShuttle</arrivingSkyfaller>
    <leavingSkyfaller>PassengerShuttleLeaving</leavingSkyfaller>
    <worldObject>SettlementTransport_ShuttleFlight</worldObject>
    <playerShuttle>true</playerShuttle>
  </TransportShipDef>
  <WorldObjectDef>
    <defName>SettlementTransport_ShuttleMarker</defName>
    <label>landing passenger shuttle</label>
    <worldObjectClass>Settlement_Services.Services.Transport.SettlementTransportMarker</worldObjectClass>
    <texture>World/WorldObjects/Expanding/PassengerShuttle</texture>
    <useDynamicDrawer>true</useDynamicDrawer>
    <selectable>false</selectable>
    <canHaveMap>false</canHaveMap>
    <validLaunchTarget>false</validLaunchTarget>
  </WorldObjectDef>
  <ShipJobDef>
    <defName>SettlementTransport_Unload</defName>
    <jobClass>Settlement_Services.Services.Transport.ShipJob_SettlementTransportUnload</jobClass>
  </ShipJobDef>
</Defs>
