<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <Settlement_Services.Framework.Defs.ServiceEventDef>
    <defName>SettlementServiceEvent_Vehicle_HiddenDamageFound</defName>
    <disabled>true</disabled>
    <label>hidden damage found</label>
    <description>The mechanics find hidden damage once they get the panels off.</description>
    <weightClass>Complication</weightClass>
    <triggerPhase>DuringService</triggerPhase>
    <selectionWeight>0.6</selectionWeight>
    <eligibleCategoryDefNames>
      <li>SettlementService_Technical</li>
    </eligibleCategoryDefNames>
    <effects>
      <durationDeltaTicks>15000</durationDeltaTicks>
    </effects>
  </Settlement_Services.Framework.Defs.ServiceEventDef>

  <Settlement_Services.Framework.Defs.ServiceEventDef>
    <defName>SettlementServiceEvent_Vehicle_QuickRepair</defName>
    <disabled>true</disabled>
    <label>quick repair</label>
    <description>The fix turns out to be simpler than expected.</description>
    <weightClass>MinorPositive</weightClass>
    <triggerPhase>DuringService</triggerPhase>
    <selectionWeight>0.8</selectionWeight>
    <eligibleCategoryDefNames>
      <li>SettlementService_Technical</li>
    </eligibleCategoryDefNames>
    <effects>
      <durationDeltaTicks>-15000</durationDeltaTicks>
    </effects>
  </Settlement_Services.Framework.Defs.ServiceEventDef>

  <Settlement_Services.Framework.Defs.ServiceEventDef>
    <defName>SettlementServiceEvent_Vehicle_SalvagedPartsAvailable</defName>
    <disabled>true</disabled>
    <label>salvaged parts available</label>
    <description>The workshop has salvaged parts on hand that cut down the material cost.</description>
    <weightClass>MinorPositive</weightClass>
    <triggerPhase>OnStart</triggerPhase>
    <selectionWeight>1.0</selectionWeight>
    <eligibleCategoryDefNames>
      <li>SettlementService_Technical</li>
    </eligibleCategoryDefNames>
    <effects>
      <refundAmount>10</refundAmount>
    </effects>
  </Settlement_Services.Framework.Defs.ServiceEventDef>

  <Settlement_Services.Framework.Defs.ServiceEventDef>
    <defName>SettlementServiceEvent_Vehicle_WorkshopBacklog</defName>
    <disabled>true</disabled>
    <label>workshop backlog</label>
    <description>The workshop is backed up with other repair jobs ahead of yours.</description>
    <weightClass>Complication</weightClass>
    <triggerPhase>OnStart</triggerPhase>
    <selectionWeight>0.6</selectionWeight>
    <eligibleCategoryDefNames>
      <li>SettlementService_Technical</li>
    </eligibleCategoryDefNames>
    <effects>
      <durationDeltaTicks>15000</durationDeltaTicks>
    </effects>
  </Settlement_Services.Framework.Defs.ServiceEventDef>

  <Settlement_Services.Framework.Defs.ServiceEventDef>
    <defName>SettlementServiceEvent_Vehicle_FleetDiscount</defName>
    <disabled>true</disabled>
    <label>fleet discount</label>
    <description>The workshop offers a discount for keeping their bays busy.</description>
    <weightClass>MinorPositive</weightClass>
    <triggerPhase>OnStart</triggerPhase>
    <selectionWeight>1.0</selectionWeight>
    <eligibleCategoryDefNames>
      <li>SettlementService_Technical</li>
    </eligibleCategoryDefNames>
    <effects>
      <refundAmount>10</refundAmount>
    </effects>
  </Settlement_Services.Framework.Defs.ServiceEventDef>

  <Settlement_Services.Framework.Defs.ServiceEventDef>
    <defName>SettlementServiceEvent_Vehicle_WorkshopReferral</defName>
    <disabled>true</disabled>
    <label>workshop referral</label>
    <description>The mechanics mention another settlement with a better-equipped workshop.</description>
    <weightClass>Discovery</weightClass>
    <triggerPhase>OnComplete</triggerPhase>
    <selectionWeight>0.6</selectionWeight>
    <eligibleCategoryDefNames>
      <li>SettlementService_Technical</li>
    </eligibleCategoryDefNames>
    <effects>
      <referralCategoryDefName>SettlementService_Technical</referralCategoryDefName>
    </effects>
  </Settlement_Services.Framework.Defs.ServiceEventDef>

</Defs>
