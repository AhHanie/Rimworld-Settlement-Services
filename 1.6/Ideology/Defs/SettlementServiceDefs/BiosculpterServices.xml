<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <Settlement_Services.Framework.Defs.SettlementServiceDef>
    <defName>SettlementService_BiosculpterTreatment</defName>
    <category>SettlementService_Medical</category>
    <label>biosculpter treatment</label>
    <description>Undergo a biosculpter pod cycle: regrowth of a missing body part (bioregeneration) or age reversal, chosen at request time.</description>
    <workerClass>Settlement_Services.Services.Genetics.BiosculpterTreatmentServiceWorker</workerClass>
    <requiredTechLevel>Industrial</requiredTechLevel>
    <minimumGoodwill>40</minimumGoodwill>
    <minimumCost>180</minimumCost>
    <wealthScale>0.06</wealthScale>
    <duration>1500000</duration>    <!-- 25 days; fallback only, the worker computes the actual selected-cycle duration -->
    <targetRule>Pawn</targetRule>
    <batchMode>Targets</batchMode>
    <restoresParticipantFoodAndRest>true</restoresParticipantFoodAndRest>
    <iconTexPath>SettlementServices/UI/Icons/biosculpter</iconTexPath>
  </Settlement_Services.Framework.Defs.SettlementServiceDef>

</Defs>
