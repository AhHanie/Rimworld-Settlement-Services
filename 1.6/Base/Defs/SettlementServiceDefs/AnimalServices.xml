    <wealthScale>0</wealthScale>
    <duration>0</duration>
    <hideExpectedDuration>true</hideExpectedDuration>
    <eventChancePct>0</eventChancePct>
    <targetRule>None</targetRule>
    <batchMode>None</batchMode>
    <allowRemoteDiscovery>false</allowRemoteDiscovery>
    <allowRemoteRequest>false</allowRemoteRequest>
    <iconTexPath>SettlementServices/UI/Icons/animal-dog</iconTexPath>
