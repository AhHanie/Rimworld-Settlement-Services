<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <Settlement_Services.Framework.Defs.ServiceEventDef>
    <defName>SettlementServiceEvent_Medical_ExceptionalTreatment</defName>
    <label>exceptional treatment</label>
    <description>The medical staff handle the case with unusual skill, finishing well ahead of schedule.</description>
    <weightClass>MinorPositive</weightClass>
    <triggerPhase>DuringService</triggerPhase>
    <selectionWeight>1.0</selectionWeight>
    <eligibleCategoryDefNames>
      <li>SettlementService_Medical</li>
    </eligibleCategoryDefNames>
    <requiresPawnTarget>true</requiresPawnTarget>
    <effects>
      <durationDeltaPct>-0.1</durationDeltaPct>
    </effects>
  </Settlement_Services.Framework.Defs.ServiceEventDef>

  <Settlement_Services.Framework.Defs.ServiceEventDef>
    <defName>SettlementServiceEvent_Medical_PreventativeTreatment</defName>
    <label>preventative treatment</label>
    <description>The settlement's staff administer a complimentary penoxycyline dose to every patient, providing temporary protection from preventable diseases.</description>
    <weightClass>MinorPositive</weightClass>
    <triggerPhase>OnStart</triggerPhase>
    <selectionWeight>0.6</selectionWeight>
    <eligibleCategoryDefNames>
      <li>SettlementService_Medical</li>
    </eligibleCategoryDefNames>
    <requiresPawnTarget>true</requiresPawnTarget>
    <workerClass>Settlement_Services.Framework.Events.Workers.PreventativeTreatmentServiceEventWorker</workerClass>
  </Settlement_Services.Framework.Defs.ServiceEventDef>

  <Settlement_Services.Framework.Defs.ServiceEventDef>
    <defName>SettlementServiceEvent_Medical_GoodBedsideManner</defName>
    <label>good bedside manner</label>
    <description>The attending staff put your colonists at ease throughout the whole procedure.</description>
    <weightClass>MinorPositive</weightClass>
    <triggerPhase>OnComplete</triggerPhase>
    <selectionWeight>1.0</selectionWeight>
    <eligibleCategoryDefNames>
      <li>SettlementService_Medical</li>
    </eligibleCategoryDefNames>
    <requiresPawnTarget>true</requiresPawnTarget>
    <effects>
      <thoughtDefName>SettlementServiceEvent_PositiveExperience</thoughtDefName>
      <grantThoughtToAllParticipants>true</grantThoughtToAllParticipants>
    </effects>
  </Settlement_Services.Framework.Defs.ServiceEventDef>

  <Settlement_Services.Framework.Defs.ServiceEventDef>
    <defName>SettlementServiceEvent_Medical_PoorBedsideManner</defName>
    <label>poor bedside manner</label>
    <description>The attending staff are brusque and dismissive with your colonists throughout the procedure.</description>
    <weightClass>Complication</weightClass>
    <triggerPhase>OnComplete</triggerPhase>
    <selectionWeight>0.4</selectionWeight>
    <eligibleCategoryDefNames>
      <li>SettlementService_Medical</li>
    </eligibleCategoryDefNames>
    <requiresPawnTarget>true</requiresPawnTarget>
    <effects>
      <thoughtDefName>SettlementServiceEvent_NegativeExperience</thoughtDefName>
      <grantThoughtToAllParticipants>true</grantThoughtToAllParticipants>
    </effects>
  </Settlement_Services.Framework.Defs.ServiceEventDef>

  <Settlement_Services.Framework.Defs.ServiceEventDef>
    <defName>SettlementServiceEvent_Medical_TreatmentComplication</defName>
    <label>treatment complication</label>
    <description>The treatment turns out to be more involved than first thought.</description>
    <weightClass>Complication</weightClass>
    <triggerPhase>DuringService</triggerPhase>
    <selectionWeight>0.6</selectionWeight>
    <eligibleCategoryDefNames>
      <li>SettlementService_Medical</li>
    </eligibleCategoryDefNames>
    <requiresPawnTarget>true</requiresPawnTarget>
    <effects>
      <durationDeltaPct>0.1</durationDeltaPct>
    </effects>
  </Settlement_Services.Framework.Defs.ServiceEventDef>

  <Settlement_Services.Framework.Defs.ServiceEventDef>
    <defName>SettlementServiceEvent_Medical_SuccessfulRehabilitation</defName>
    <label>successful rehabilitation</label>
    <description>The long-term rehabilitation program pays off: the patient leaves with renewed mobility and a clear, focused mind.</description>
    <weightClass>MinorPositive</weightClass>
    <triggerPhase>OnComplete</triggerPhase>
    <selectionWeight>0.6</selectionWeight>
    <eligibleServiceDefNames>
      <li>SettlementService_ExtendedTreatment</li>
    </eligibleServiceDefNames>
    <requiresPawnTarget>true</requiresPawnTarget>
    <workerClass>Settlement_Services.Framework.Events.Workers.SuccessfulRehabilitationServiceEventWorker</workerClass>
    <effects>
      <hediffDefName>SettlementService_SuccessfulRehabilitation</hediffDefName>
    </effects>
  </Settlement_Services.Framework.Defs.ServiceEventDef>

  <Settlement_Services.Framework.Defs.ServiceEventDef>
    <defName>SettlementServiceEvent_Medical_SurgicalComplication</defName>
    <label>surgical complication</label>
    <description>The operation does not go as smoothly as planned, leaving one of the patients with a fresh injury near the operated site. The settlement's staff tend the wound at once and refund part of the fee.</description>
    <weightClass>Complication</weightClass>
    <triggerPhase>OnComplete</triggerPhase>
    <selectionWeight>0.4</selectionWeight>
    <eligibleServiceDefNames>
      <li>SettlementService_Surgery</li>
    </eligibleServiceDefNames>
    <requiresPawnTarget>true</requiresPawnTarget>
    <workerClass>Settlement_Services.Framework.Events.Workers.SurgicalComplicationServiceEventWorker</workerClass>
    <effects>
      <refundFraction>0.30</refundFraction>
    </effects>
  </Settlement_Services.Framework.Defs.ServiceEventDef>

  <Settlement_Services.Framework.Defs.ServiceEventDef>
    <defName>SettlementServiceEvent_Medical_ResearchVolunteer</defName>
    <label>medical research volunteers</label>
    <description>Your colonists agree to answer a few questions for the settlement's own medical records, and pick up a little insight in the process.</description>
    <weightClass>Discovery</weightClass>
    <triggerPhase>OnStart</triggerPhase>
    <selectionWeight>1.0</selectionWeight>
    <eligibleCategoryDefNames>
      <li>SettlementService_Medical</li>
    </eligibleCategoryDefNames>
    <requiresPawnTarget>true</requiresPawnTarget>
    <effects>
      <experienceSkillDefName>Intellectual</experienceSkillDefName>
      <experienceAmount>1000</experienceAmount>
      <grantExperienceToAllParticipants>true</grantExperienceToAllParticipants>
    </effects>
  </Settlement_Services.Framework.Defs.ServiceEventDef>

  <Settlement_Services.Framework.Defs.ServiceEventDef>
    <defName>SettlementServiceEvent_Medical_Referral</defName>
    <label>medical referral</label>
    <description>The medical staff recommend another nearby settlement with capable medical services.</description>
    <weightClass>Discovery</weightClass>
    <triggerPhase>OnComplete</triggerPhase>
    <selectionWeight>0.6</selectionWeight>
    <eligibleCategoryDefNames>
      <li>SettlementService_Medical</li>
    </eligibleCategoryDefNames>
    <requiresPawnTarget>true</requiresPawnTarget>
    <effects>
      <referralCategoryDefName>SettlementService_Medical</referralCategoryDefName>
    </effects>
  </Settlement_Services.Framework.Defs.ServiceEventDef>

</Defs>
