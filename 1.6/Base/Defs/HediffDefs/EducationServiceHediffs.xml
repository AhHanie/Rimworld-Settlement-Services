<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>SettlementService_InspirationalTeacher</defName>
    <label>inspired to learn</label>
    <description>A recent lesson left a lasting impression, sharpening focus and speeding up learning for a while.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
    <stages>
      <li>
        <statFactors>
          <GlobalLearningFactor>1.20</GlobalLearningFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
