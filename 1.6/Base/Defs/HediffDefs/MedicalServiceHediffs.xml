<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>SettlementService_SuccessfulRehabilitation</defName>
    <label>successfully rehabilitated</label>
    <description>A temporary boost to movement and work speed following a successful course of long-term rehabilitation.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>180000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>1.15</MoveSpeed>
        </statFactors>
        <statOffsets>
          <WorkSpeedGlobal>0.20</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
