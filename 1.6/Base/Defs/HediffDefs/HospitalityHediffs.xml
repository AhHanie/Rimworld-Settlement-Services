<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>SettlementService_Hospitality_SpaAfterglow</defName>
    <label>spa afterglow</label>
    <description>A lingering calm and looseness from a recent spa and bathhouse session. Fades on its own.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MentalBreakThreshold>-0.03</MentalBreakThreshold>
        </statOffsets>
        <statFactors>
          <RestFallRateFactor>0.90</RestFallRateFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
